as.paleoTS(mm = x$mm, vv = x$vv, nn = x$nn, tt = x$tt)
})
# run adequacy test for an unbiased random walk on relative fit dataset
# (the warnings are ok)
# The output of the test can vary with ca. +/- one time series (i.e., you will
# not always get the exact same number of time series that pass the adequacy test)
adequacy <- lapply(relative_paleo, fit3adequacy.RW, plot = FALSE)
# append results from adequacy test to relative
absolute <- mapply(c, relative, adequacy, SIMPLIFY = FALSE)
# get only adequate unbiased random walk time series
# (adequate function from empirical_functions.R)
absolute <- adequate(absolute)
View(absolute)
# append parameters from test to ln_data_meta
URW_absolute <- mapply(c, absolute, complete_meta, SIMPLIFY = FALSE)
View(URW_absolute)
View(absolute)
rm(list = ls())
# import functions
source("./model_ident_functions.R")
# import complete, relative fit and absolute fit datasets
load("./complete.Rdata")
load("./relative.Rdata")
load("./absolute.Rdata")
View(absolute)
View(complete)
# import time series and metadata
timeseries <- read_delim("./timeseries.txt", col_names = TRUE, delim = "\t")
metadata <- read_delim("./metadata.txt", col_names = TRUE, delim = "\t")
# join data frames
df <- left_join(timeseries, metadata, by = c("tsID"))
# remove modern time series
df <- subset(df, sediment!="none")
df <- subset(df, trait_type!="complex")
# remove time series with less than 5 steps
df <- subset(df, steps >= 5)
# make list based on ID
df <- lapply(split(df,df$tsID), function(x) as.list(x))
# import functions
source("./empirical_functions.R")
# process data into right form (function dt from empirical_functions.R)
# with metadata
complete_meta <- dt(df, "tsID")
View(relative)
View(complete_meta)
View(relative)
# import datasets with metadata
save(file = "./complete_meta", complete_meta)
# import datasets with metadata
save(file = "./complete_meta.Rdata", complete_meta)
# import datasets with metadata
# Get the common names between the two lists
common_names <- intersect(names(relative), names(complete_meta))
# Combine the lists based on matching names
relative_meta <- lapply(common_names, function(name) {
list(c(relative[[name]], complete_meta[[name]]))
})
View(relative_meta)
# Combine the lists based on matching names
relative_meta <- lapply(common_names, function(name) {
c(relative[[name]], complete_meta[[name]])
})
View(relative_meta)
View(relative)
# import datasets with metadata
# Get the common names between the two lists
common_names <- intersect(names(relative), names(complete_meta))
# Combine the lists based on matching names
relative_meta <- lapply(common_names, function(name) {
c(relative[[name]], complete_meta[[name]])
})
View(relative_meta)
